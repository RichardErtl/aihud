    { "name": "--aihud-main", "meaning": "the main agent's share", "dark": "#cfd6df", "light": "#3b4350" },
    { "name": "--aihud-sub", "meaning": "the subagents' share", "dark": "#6b7580", "light": "#9aa3ad" },
    { "name": "--aihud-role", "meaning": "per-role bars", "dark": "#7d8896", "light": "#7d8896" },
