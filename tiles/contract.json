  "render": {
    "signature": "render(el, data, size)",
    "size": {
      "cols": "width of the tile in grid units",
      "rows": "height of the tile in grid units",
      "unit": "pixels per grid unit (square cells)"
    }
  },
  "grid": {
    "portraitColumns": 8,
    "unitRule": "unit = inner width of the portrait strip / 8",
    "floorPx": 20,
    "basePx": 22.5,
    "minPx": 15,
    "landscapeRows": 6,
    "landscapeRowsStandard": 7,
    "unitStepPx": 0.5,
    "portraitUnitRule": "unit = inner width / 8, rounded down to unitStepPx, at least minPx",
    "landscapeUnitRule": "unit = inner height / band rows, rounded down to unitStepPx, at least minPx; band rows = the layout's row extent, at least landscapeRows"
  },
  "layoutFile": {
    "keys": ["name", "orientation", "tiles"],
    "optionalKeys": ["form"],
    "formMax": {"cols": 120, "rows": 60},
    "formKeys": ["cols", "rows"],
    "form": "optional {cols, rows} = the grid form the composer showed; every tile fits inside it; portrait cols = 8, landscape rows <= 7; a file without it is drawn at the extent of its tiles",
    "placementKeys": ["tile", "col", "row"],
    "orientations": ["portrait", "landscape"],
    "tileSize": "the tile's meta.sizes[0]; a placement carries no size of its own",
    "portraitMaxCols": 8,
    "landscapeMaxRows": 7,
    "own": "derived by the node from the folder (<aihud home>/layouts = own, package layouts = shipped), never a key of the file"
  },
  "meta": {
