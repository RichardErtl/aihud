    { "name": "--aihud-heat-text-0", "meaning": "heat scale for numbers, needles and thin strokes, stop 0 %", "dark": "#ffffff", "light": "#7d8590" },
    { "name": "--aihud-heat-text-30", "meaning": "heat scale for numbers, stop 30 %", "dark": "#ffd21f", "light": "#a87d00" },
    { "name": "--aihud-heat-text-50", "meaning": "heat scale for numbers, stop 50 %", "dark": "#ff8c1a", "light": "#d96500" },
    { "name": "--aihud-heat-text-75", "meaning": "heat scale for numbers, stop 75 %", "dark": "#e8301c", "light": "#d8261a" },
    { "name": "--aihud-heat-text-100", "meaning": "heat scale for numbers, stop 100 %", "dark": "#a0001a", "light": "#8b0016" },
    { "name": "--aihud-heat-rest", "meaning": "opacity of a heat-coloured part that is not reached yet (the gauge's unlit blocks)", "dark": "0.13", "light": "0.18" },
    { "name": "--aihud-glow", "meaning": "blur of the glow around a heat-coloured ring (drop-shadow; 0 = no glow)", "dark": "3px", "light": "0px" },
    { "name": "--aihud-glow-core", "meaning": "opacity of the glow inside a ring at its centre", "dark": "0.45", "light": "0.38" },
    { "name": "--aihud-glow-mid", "meaning": "opacity of the glow inside a ring at a third of its radius", "dark": "0.16", "light": "0.12" },
    { "name": "--aihud-glow-halo", "meaning": "opacity of the blurred halo along a glowing rim", "dark": "0.22", "light": "0.12" },
    { "name": "--aihud-role-1", "meaning": "largest role part (agent type)", "dark": "#c9b8ff", "light": "#6d4fd1" },
    { "name": "--aihud-role-2", "meaning": "second role part", "dark": "#9d86f0", "light": "#9479e6" },
    { "name": "--aihud-role-3", "meaning": "third role part (or the rest)", "dark": "#6f5bc4", "light": "#c2b2f2" },
    { "name": "--aihud-absent", "meaning": "a value the provider does not record (drawn as a dash)", "dark": "#a78bfa", "light": "#7c3aed" }
  ],
  "heat": {
    "source": "the accepted sketch's gauge scale, taken over exactly; every value copied, none derived",
    "stops": [0, 30, 50, 75, 100],
    "fill": ["--aihud-heat-0", "--aihud-heat-30", "--aihud-heat-50", "--aihud-heat-75", "--aihud-heat-100"],
    "text": ["--aihud-heat-text-0", "--aihud-heat-text-30", "--aihud-heat-text-50", "--aihud-heat-text-75", "--aihud-heat-text-100"],
    "rest": "--aihud-heat-rest",
    "function": "heat(v): clamp v to 0..100; take the neighbouring stops a < b with a < v <= b (v = 0 → a = 0, b = 30); colour = color-mix(in srgb, var(<stop a>) p%, var(<stop b>)) with p = (b - v) / (b - a) × 100, p written with one decimal",
    "use": "fill = surfaces (gauge blocks, rings, columns, glow); text = numbers, needles and thin strokes drawn in the heat colour"
  },
  "fields": [
    { "path": "version", "meaning": "version of the data sheet as a whole", "hint": "Version of this data sheet", "unit": "version string", "source": "exact" },
    { "path": "not_delivered", "meaning": "types or fields the reader could not deliver, by name; a missing value is named here instead of invented", "hint": "Things the reader could not deliver", "unit": "list of names", "source": "exact" },
    { "path": "caveats", "meaning": "caveats the reader could not verify, as whitespace-free marks", "hint": "Things the reader could not verify", "unit": "list of marks", "source": "exact" },
    {"path": "windows", "meaning": "context window size per model the session used, keyed by provider, then model", "hint": "Context window size per model", "unit": "object", "source": "estimated", "optional": true},
    {"path": "windows.<key>", "meaning": "the models of one provider; key = provider (`claude-code`, `codex`; `antigravity` has no model: its entry `default` is the assumed window: `settings.json windows.antigravity.default`, else the shipped 1,048,576)", "hint": "The models of one provider", "unit": "object", "source": "estimated", "optional": false},
    {"path": "windows.<key>.<key>", "meaning": "window size of one model; key = model id as written; Claude Code: from a model table, it is in no transcript line; Codex: the size its own rollout names (`model_context_window`), a model without a known size is left out; Antigravity: key `default`, the size ASSUMED in settings (`windows.antigravity.default`) else shipped, the transcript names none", "hint": "Context window size of this model", "unit": "tokens", "source": "estimated", "optional": false},

    { "path": "session", "meaning": "the session card; missing when the session has no id or no start", "hint": "The card of this session", "unit": "object", "source": "exact" },
    { "path": "session.version", "meaning": "version of this type", "hint": "Version of the session card", "unit": "version string", "source": "exact" },
    { "path": "session.as_of", "meaning": "when the reader built this sheet", "hint": "When this sheet was built", "unit": "ISO-8601 UTC", "source": "exact" },
    { "path": "session.id", "meaning": "session id", "hint": "Id of this session", "unit": "id", "source": "exact" },
    { "path": "session.model", "meaning": "model of the main agent, last seen", "hint": "Model the main agent is using", "unit": "model id", "source": "exact", "gap": "session:model" },
    { "path": "session.work_ms", "meaning": "session runtime without the waiting time between turns", "hint": "Session time without the waiting between turns", "unit": "milliseconds", "source": "exact" },
    { "path": "session.wait_ms", "meaning": "sum of the gaps between the end of one turn and the start of the next", "hint": "Time spent waiting between turns", "unit": "milliseconds", "source": "exact" },
    {"path": "session.provider", "meaning": "provider of this session: `claude-code`, `codex` or `antigravity` (Antigravity: tokens since CLI 1.2.17, never a model or a title: those fields are absent and named in `not_delivered`)", "hint": "Which tool recorded this session", "unit": "id", "source": "exact", "optional": false},
    {"path": "session.started_at", "meaning": "first timestamp of the session", "hint": "When this session started", "unit": "ISO-8601 UTC", "source": "exact", "optional": false},
    {"path": "session.title", "meaning": "sidecar title, else the ai-title Claude Code wrote, or the thread_name of the Codex session index; plain text, only when the host asks for text", "hint": "Title of this session", "unit": "text", "source": "exact", "optional": true},
    {"path": "session.note", "meaning": "the user's note from the sidecar; plain text, only when the host asks for text", "hint": "Your note on this session", "unit": "text", "source": "exact", "optional": true},
    {"path": "session.closed", "meaning": "the user marked the session closed (sidecar)", "hint": "You marked this session as closed", "unit": "boolean", "source": "exact", "optional": true},
    {"path": "session.closed_at", "meaning": "when the session was marked closed (sidecar)", "hint": "When you marked this session as closed", "unit": "ISO-8601", "source": "exact", "optional": true},
    {"path": "session.git", "meaning": "git state of the session's working directory; missing when neither a repository nor a commit was found", "hint": "Git state of the session folder", "unit": "object", "source": "exact", "optional": true},
    {"path": "session.git.start_head", "meaning": "commit HEAD pointed at when the session started, from the reflog or .git/HEAD; missing when not provable", "hint": "Commit the folder was on at session start", "unit": "commit hash", "source": "exact", "optional": true},
    {"path": "session.git.commits", "meaning": "commits made in the session's time window, ascending", "hint": "Commits made during this session", "unit": "list", "source": "exact", "optional": false},
    {"path": "session.git.commits[].sha", "meaning": "commit hash; abbreviated when only the transcript knows it", "hint": "Short id of the commit", "unit": "commit hash", "source": "exact", "optional": false},
    {"path": "session.git.commits[].at", "meaning": "time of the commit (transcript line or reflog entry)", "hint": "When the commit was made", "unit": "ISO-8601 UTC", "source": "exact", "optional": true},
    {"path": "session.git.commits[].first_line", "meaning": "first line of the commit message, from the reflog; plain text, only when the host asks for text", "hint": "First line of the commit message", "unit": "text", "source": "exact", "optional": true},
    {"path": "session.git.commits[].source", "meaning": "`transcript` = made by this session for sure; `reflog` = in the time window, maybe another session in the same checkout", "hint": "Whether this session surely made the commit", "unit": "text", "source": "exact", "optional": false},
    {"path": "session.git.dirty", "meaning": "working tree has uncommitted changes; `null` = not determined (the reader starts no git process)", "hint": "Whether the folder has unsaved changes", "unit": "boolean or null", "source": "exact", "optional": false},

    { "path": "live", "meaning": "who is running right now; missing when the host did not name device and state", "hint": "Who is running right now", "unit": "object", "source": "exact" },
